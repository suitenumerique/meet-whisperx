# =========================
# ASR API configuration
# =========================

# --- Required secrets ---
# API key used to authenticate requests
API_KEY=

# Hugging Face access token (required for some models)
HF_TOKEN=

# =========================
# Inference configuration
# =========================

# Maximum batch size for transcription
BATCH_SIZE=16

# Device running the torch models, alignment and diarization: cuda, mps or cpu.
# Auto-detected when left empty. Transcription itself never runs on mps: the
# CTranslate2 backend has no Metal support, so it is pinned to cpu.
# DEVICE=

# Compute type of the transcription model: float16, int8, float32…
# Defaults to float16 on cuda and float32 elsewhere.
# COMPUTE_TYPE=

# Threads used by the transcription model when it runs on CPU. Raising it to the
# number of performance cores roughly halves the transcription time.
CPU_THREADS=4

# Model name (e.g. large-v2, medium, small)
TRANSCRIBE_MODEL=large-v2

# Default languages for align model
PRELOADED_ALIGN_MODEL_LANGUAGES=["en","fr","nl","de"]

# Keep-alive timeout (seconds)
TIMEOUT_KEEP_ALIVE=60

# Torch: return character-level alignments (true/false)
RETURN_CHAR_ALIGNMENTS=false

# Whisperx Interpolation method
INTERPOLATE_METHOD=nearest

# Fill nearest gaps in alignment
FILL_NEAREST=false

# =========================
# Server settings
# =========================

# Port to bind the server
PORT=8000

# Enable auto-reload (development only)
RELOAD=false

# Root path if running behind a reverse proxy
# ROOT_PATH=

# Path to logging configuration file
LOGGING_CONFIG=logging-config.yaml

# Enable debug mode
DEBUG=false
